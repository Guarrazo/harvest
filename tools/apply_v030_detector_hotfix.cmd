@echo off\nsetlocal EnableExtensions\nif "%~1"=="" (\n  echo Usage: apply_v030_detector_hotfix.cmd ^<NCIG repo root^>\n  exit /b 2\n)\nset "ROOT=%~1"\nset "SRC=%~dp0..\src\ncig\city_index_detect.py"\nif not exist "%ROOT%\src\ncig" exit /b 2\nset "BACKUP=%ROOT%\build\patch_backups\v030_detector_hotfix"\nif not exist "%BACKUP%" mkdir "%BACKUP%"\nif exist "%ROOT%\src\ncig\city_index_detect.py" copy /y "%ROOT%\src\ncig\city_index_detect.py" "%BACKUP%\city_index_detect.py.before_v030" >nul\ncopy /y "%SRC%" "%ROOT%\src\ncig\city_index_detect.py" >nul || exit /b 1\nset "PYTHONEXE="\nfor /f "delims=" %%P in ('py -3 -c "import sys; print(sys.executable)" 2^>nul') do if not defined PYTHONEXE set "PYTHONEXE=%%P"\nif not defined PYTHONEXE (\n  echo NCIG: Windows Python not found. File installed; run py_compile manually.\n  exit /b 0\n)\nset "PYTHONPATH=%ROOT%\src"\n"%PYTHONEXE%" -m py_compile "%ROOT%\src\ncig\city_index_detect.py"\nif errorlevel 1 exit /b 3\necho NCIG v0.30 detector hotfix installed.\nexit /b 0\n